# Copy to .env.local and fill in. All AI features degrade gracefully to local
# fallbacks when no key is set — the app is fully usable without one.

# OpenAI key for natural-language material search (/api/search) and
# texture auto-tagging (/api/tag-texture).
OPENAI_API_KEY=

# Optional model overrides (defaults: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
